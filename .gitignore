# Runtime-generated score caches (derived from screener_ohlcv.parquet; stale next trading day)
data/stage2_cache.parquet
data/momentum_cache.parquet

# Local yfinance delta caches — accumulate tail rows fetched since last parquet rebuild.
# Gitignored so the committed baseline stays clean; rebuilt automatically at runtime.
data/backtest_delta.parquet
data/benchmarks_delta.parquet

# Backtest batch run outputs (CSVs, logs, checkpoints)
batch_*.csv
batch_*.log
batch_*.py
